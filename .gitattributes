# Auto detect text files and perform LF normalization
* text=auto

# Code and text files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.geojson text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.csv text eol=lf

# Binary & compressed archives
*.gz binary
*.db binary
*.sqlite binary
